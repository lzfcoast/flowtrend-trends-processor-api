# Servidor
NODE_ENV=production
PORT=3000

# Persistência local JSON
LOCAL_DATABASE_PATH=server/database.json
ARTICLE_RETENTION_DAYS=45
ARTICLE_RETENTION_MAX=300

# Worker Google Trends RSS
TRENDS_INTERVAL_MINUTES=5
PYTHON_BIN=python3

# Segurança das rotas editoriais protegidas
FLOWTREND_AUTOMATION_TOKEN=gere-um-token-longo-e-aleatorio

# Configuração pública opcional
FLOWTREND_SITE_URL=https://www.flowtrend.com.br
FLOWTREND_API_BASE_URL=
FLOWTREND_CONFIG_PATH=server/site-config.json

# IA e armazenamento opcionais; não são necessários para o fallback Wikimedia
MANUS_API_URL=
MANUS_API_KEY=
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_API_URL=
OWNER_OPEN_ID=
